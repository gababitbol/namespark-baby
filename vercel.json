{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/generate.js": {
      "includeFiles": "api/_data/**"
    }
  },
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/vote/:id",
      "destination": "/?invite=:id",
      "permanent": false
    },
    {
      "source": "/family/:id",
      "destination": "/?familyVote=:id",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 9 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/names",
      "destination": "/api/generate?mode=hydrate"
    },
    {
      "source": "/api/search",
      "destination": "/api/generate?mode=search"
    },
    {
      "source": "/prenom-garcon",
      "destination": "/seo/prenom-garcon"
    },
    {
      "source": "/prenom-fille",
      "destination": "/seo/prenom-fille"
    },
    {
      "source": "/prenom-hebreu",
      "destination": "/seo/prenom-hebreu"
    },
    {
      "source": "/prenom-rare",
      "destination": "/seo/prenom-rare"
    },
    {
      "source": "/prenom-court",
      "destination": "/seo/prenom-court"
    },
    {
      "source": "/prenom-signification-force",
      "destination": "/seo/prenom-signification-force"
    }
  ]
}